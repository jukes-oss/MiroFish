{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mirofish:tweet:action-batch:v2",
  "title": "action-batch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 240,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "action": {
            "$ref": "urn:mirofish:tweet:action:v2"
          }
        },
        "required": [
          "agent_id",
          "action"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "round",
    "results"
  ]
}
